diff a/BUILD.gn b/BUILD.gn	(rejected hunks)
@@ -1,25 +1,45 @@
 # Copyright 2014 The Chromium Authors. All rights reserved.
 # Use of this source code is governed by a BSD-style license that can be
 # found in the LICENSE file.
 
+declare_args() {
+  # build_host = true and build_arkweb = false is used to build d8
+  build_host = false
+  build_arkweb = true
+}
+if (build_host && !build_arkweb) {
+  is_ohos = build_host == false
+  is_arkweb = build_arkweb
+}
+
 import("//build/config/android/config.gni")
+if (is_ohos) {
+  import("//build/config/ohos/config.gni")
+}
 import("//build/config/arm.gni")
 import("//build/config/coverage/coverage.gni")
 import("//build/config/dcheck_always_on.gni")
 import("//build/config/host_byteorder.gni")
 import("//build/config/mips.gni")
 import("//build/config/riscv.gni")
 import("//build/config/rust.gni")
 import("//build/config/sanitizers/sanitizers.gni")
 import("//build_overrides/build.gni")
-import("//cef/libcef/features/features.gni")
+if (build_host) {
+  enable_cef = false
+} else {
+  import("//cef/libcef/features/features.gni")
+}
 import("//third_party/icu/config.gni")
 
 import("gni/snapshot_toolchain.gni")
 import("gni/v8.gni")
+import("//arkweb/chromium_ext/v8/build.gni")
+
 import("//arkweb/chromium_ext/v8/dfx/heap_dump/heap-dump.gni")
+
 
 if (is_clang) {
   import("//build/config/clang/clang.gni")
 }
 
@@ -500,18 +540,29 @@ declare_args() {
 
   # Enable compilation of riscv32.
   v8_riscv_enable_deprecated_riscv32 = false
 }
 
 declare_args() {
   # Enable jit memroy W^X protection.
   v8_enable_jitfort = false
 
   v8_enable_hitrace_runtime_call_stats = v8_enable_ohos_js_engine
 }
 
 # Derived defaults.
+pgo_exists_flag = false
+if(is_ohos) {
+  pgo_exists_flag = exec_script("tools/builtins-pgo/check_pgo.py", ["--pgo_path", "profiles/ohos.profile"], "value")
+}
+if (pgo_exists_flag) {
+  v8_builtins_profiling_log_file = "tools/builtins-pgo/profiles/ohos.profile"
+} else {
+  v8_builtins_profiling_log_file = "default"
+}
+print("Using v8_builtins_profiling from: ")
+print(v8_builtins_profiling_log_file)
 if (cppgc_enable_verify_heap == "") {
   cppgc_enable_verify_heap =
       v8_enable_verification_features || v8_dcheck_always_on
 }
 if (v8_enable_verify_heap == "") {
@@ -1491,32 +1563,68 @@ config("features") {
     defines += [ "V8_ENABLE_PARTITION_ALLOC" ]
   }
   if (v8_wasm_random_fuzzers) {
     defines += [ "V8_WASM_RANDOM_FUZZERS" ]
   }
+  if (v8_enable_ohos_js_engine) {
+    defines += [ "OHOS_JS_ENGINE" ]
+  }
+  if (v8_enable_longque_api) {
+    defines += [ "V8_ENABLE_LONGQUE_API" ]
+  }
+  if (v8_enable_ohos_perf_jit) {
+    defines += [ "V8_ENABLE_OHOS_PERF_JIT" ]
+  }
+  if (v8_enable_ohos_async_stack) {
+    defines += [ "V8_ENABLE_OHOS_ASYNC_STACK" ]
+  }
+  if (v8_enable_restrace) {
+    defines += [ "OH_ENABLE_RESTRACE" ]
+  }
+  if (v8_ohos_enable_heapdump) {
+    if (enable_heap_dump) {
+      defines += [ "OH_ENABLE_HEAP_DUMP" ]
+    }
+    if (enable_heap_dump_translate) {
+      defines += [ "OH_ENABLE_HEAP_TRANSLATE" ]
+    }
+    if (enable_heap_dump_test) {
+      defines += [ "OH_ENABLE_HEAP_DUMP_TEST" ]
+    }
+    if (enable_heap_dump_json_metadata) {
+      defines += [ "OH_ENABLE_HEAP_DUMP_JSON_METADATA" ]
+    }
+  }
   if (v8_lower_limits_mode) {
     defines += [ "V8_LOWER_LIMITS_MODE" ]
   }
   if (v8_target_is_simulator) {
     defines += [ "USE_SIMULATOR" ]
   }
   if (v8_function_arguments_caller_are_own_props) {
     defines += [ "V8_FUNCTION_ARGUMENTS_CALLER_ARE_OWN_PROPS" ]
   }
+  if (v8_enable_oom_repoter) {
+    defines += [ "V8_ENABLE_OHOS_OOM_MONITOR" ]
+  }
   if (is_ohos && v8_enable_jitfort) {
     defines += [ "V8_ENABLE_JITFORT" ]
   }
 }
 
 config("toolchain") {
   # Only targets in this file and its subdirs can depend on this.
   visibility = [ "./*" ]
 
   defines = []
   cflags = []
   ldflags = []
 
+  if (build_host) {
+    cflags += [ "-Wno-extra-tokens" ]
+  }
+
   if (v8_current_cpu == "arm") {
     defines += [ "V8_TARGET_ARCH_ARM" ]
     if (arm_version >= 7) {
       defines += [ "CAN_USE_ARMV7_INSTRUCTIONS" ]
     }
@@ -4503,10 +4636,52 @@ v8_header_set("v8_internal_headers") {
     "third_party/rapidhash-v8/secret.h",
     "third_party/siphash/halfsiphash.h",
     "third_party/utf8-decoder/utf8-decoder.h",
   ]
 
+
+  if (v8_enable_ohos_perf_jit) {
+    sources += [
+      "//arkweb/chromium_ext/v8/ohos-perf-jit.h",
+      "//arkweb/chromium_ext/v8/ohos-perf-jit.cc",
+      "//arkweb/chromium_ext/v8/parse-jitcode.cc",
+    ]
+  } else {
+    sources += [
+      "src/diagnostics/perf-jit.h",
+      "src/diagnostics/perf-jit.cc"
+    ]
+  }
+
+  if (v8_enable_ohos_async_stack) {
+    sources += [
+      "//arkweb/chromium_ext/v8/dfx/async_stack/async_stack.h",
+      "//arkweb/chromium_ext/v8/dfx/async_stack/async_stack.cpp"
+    ]
+  }
+
+  if (v8_enable_restrace) {
+    sources += [ "//arkweb/chromium_ext/v8/restrace.h" ]
+  }
+
+  if (v8_enable_oom_repoter) {
+    sources += [ "//arkweb/chromium_ext/v8/dfx/oom_mojom/v8-oom-reporter.h" ]
+  }
+
+  if (v8_ohos_enable_heapdump) {
+    sources += heap_dump_base_include
+    if (enable_heap_dump) {
+      sources += heap_dump_include
+    }
+    if (enable_heap_dump_translate) {
+      sources += heap_dump_translator_include
+    }
+    if (enable_heap_dump_test) {
+      sources += heap_dump_ut_include
+    }
+  }
+
   if (v8_enable_snapshot_compression) {
     sources += [ "src/snapshot/snapshot-compression.h" ]
   }
 
   if (v8_enable_temporal_support) {
