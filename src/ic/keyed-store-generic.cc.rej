   }
   BIND(&if_array);
   {
     TNode<IntPtrT> length =
         PositiveSmiUntag(LoadFastJSArrayLength(CAST(receiver)));
+#if defined(OHOS_MEM_USAGE_REPORT) && defined(USING_OHOS_WEB)
