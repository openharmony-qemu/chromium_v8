diff a/src/compiler-dispatcher/optimizing-compile-dispatcher.cc b/src/compiler-dispatcher/optimizing-compile-dispatcher.cc	(rejected hunks)
@@ -148,10 +152,13 @@ void OptimizingCompileTaskExecutor::RunCompilationJob(
