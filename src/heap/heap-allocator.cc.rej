diff a/src/heap/heap-allocator.cc b/src/heap/heap-allocator.cc	(rejected hunks)
@@ -518,10 +518,16 @@ bool HeapAllocator::RetryCustomAllocate(CustomAllocationFunction allocate,
 }
 
 void HeapAllocator::RetryCustomAllocateOrFail(CustomAllocationFunction allocate,
                                               AllocationType allocation) {
   if (RetryCustomAllocate(allocate, allocation)) return;
+#ifdef V8_ENABLE_OHOS_OOM_MONITOR
+  heap_->InvokeOOMMonitorCallback("CALL_AND_RETRY_LAST", V8::kHeapOOM);
+#endif
+#ifdef OHOS_JS_ENGINE
+  heap_->InvokeJSVMOOMCallback("CALL_AND_RETRY_LAST");
+#endif
   V8::FatalProcessOutOfMemory(heap_->isolate(), "CALL_AND_RETRY_LAST",
                               V8::kHeapOOM);
 }
 
